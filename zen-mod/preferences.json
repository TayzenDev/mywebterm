[
  {
    "property": "mywebterm.folder-name",
    "label": "Name of the folder to place terminals in (one per space)",
    "type": "string",
    "placeholder": "Terminal",
    "defaultValue": "Terminal"
  },
  {
    "property": "mywebterm.create-folder",
    "label": "Create the folder in the space if missing (otherwise the tab stays where it is)",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "mywebterm.leave-folder",
    "label": "Move a tab out of the folder when it leaves the terminal for another site",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mywebterm.hosts",
    "label": "Terminal addresses (host:port, comma-separated; *.localhost matches subdomains)",
    "type": "string",
    "placeholder": "127.0.0.1:8080, localhost:8080, term.localhost:8080, term.localhost",
    "defaultValue": "127.0.0.1:8080, localhost:8080, term.localhost:8080, term.localhost"
  },
  {
    "type": "separator",
    "label": "Open a terminal from the keyboard"
  },
  {
    "property": "mywebterm.shortcut",
    "label": "Shortcut (e.g. Alt+Shift+T, Ctrl+Alt+T; Alt = Option on Mac)",
    "type": "string",
    "placeholder": "Alt+Shift+T",
    "defaultValue": "Alt+Shift+T"
  },
  {
    "property": "mywebterm.open-url",
    "label": "Address to open",
    "type": "string",
    "placeholder": "http://term.localhost/",
    "defaultValue": "http://term.localhost/"
  },
  {
    "property": "mywebterm.inherit-cwd",
    "label": "From a terminal, open the new one in the same directory",
    "type": "checkbox",
    "defaultValue": true
  }
]
