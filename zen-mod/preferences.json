    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mywebterm.agent-shortcut",
    "label": "AI agent shortcut: opens a terminal that runs the command below. Same syntax as the shortcut above.",
    "type": "string",
    "placeholder": "Alt+Shift+A",
    "defaultValue": "Alt+Shift+A"
  },
  {
    "property": "mywebterm.agent-command",
    "label": "AI agent command (claude, codex…)",
    "type": "string",
    "placeholder": "claude",
