#!/bin/sh
# Sends a browser notification from the current mywebterm tab.
#   notify "tests done"             → tab title, message "tests done"
#   notify "Build" "failed at step 3"
# OSC 777 sequence (as in Ghostty): the page intercepts it, it never reaches the
# terminal. The page only notifies if the tab is not in front of you.
if [ $# -ge 2 ]; then
  title=$1
  shift
else
  title=
fi
# The ";" separates the title from the message in the sequence
title=$(printf '%s' "$title" | tr ';[:cntrl:]' ', ')
body=$(printf '%s' "$*" | tr '[:cntrl:]' ' ')
printf '\033]777;notify;%s;%s\007' "$title" "$body"
