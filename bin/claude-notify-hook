#!/usr/bin/env python3
# Hook Claude Code (Stop, Notification, PreToolUse) : notifie l'onglet mywebterm
# quand Claude a fini ou attend une réponse. Ne fait rien hors de mywebterm
# (variable MYWEBTERM posée par le serveur), on peut donc le déclarer dans
# ~/.claude/settings.json pour tous les terminaux.
#
# Claude Code lit la sortie standard des hooks : on écrit sur /dev/tty, le
# terminal de la session, et rien sur stdout.
import json
import os
import re
import sys

if not os.environ.get("MYWEBTERM"):
    sys.exit(0)

try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)


def first_line(text, limit=180):
    text = " ".join(str(text or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


event = data.get("hook_event_name")
title = body = None

if event == "Stop":
    title = "Claude a terminé"
    body = first_line(data.get("last_assistant_message"))
elif event == "Notification":
    kind = data.get("notification_type")
    message = data.get("message", "")
    # « waiting for your input » arrive une minute après Stop : déjà notifié
    if kind == "idle_prompt" or "waiting for your input" in message:
        sys.exit(0)
    title = "Claude demande une autorisation" if kind == "permission_prompt" else "Claude attend une réponse"
    body = first_line(message)
elif event == "PreToolUse":
    tool = data.get("tool_name")
    tool_input = data.get("tool_input") or {}
    if tool == "AskUserQuestion":
        questions = tool_input.get("questions") or [{}]
        title = "Claude pose une question"
        body = first_line(questions[0].get("question"))
    elif tool == "ExitPlanMode":
        title = "Claude propose un plan"
        body = ""

if title is None:
    sys.exit(0)


def clean(text):
    return re.sub(r"[\x00-\x1f\x7f]", " ", text)


seq = f"\x1b]777;notify;{clean(title).replace(';', ',')};{clean(body or '')}\x07"
# Dans tmux, la séquence doit traverser le multiplexeur (set -g allow-passthrough on)
if os.environ.get("TMUX"):
    seq = "\x1bPtmux;" + seq.replace("\x1b", "\x1b\x1b") + "\x1b\\"

try:
    with open("/dev/tty", "w") as tty:
        tty.write(seq)
except OSError:
    pass
