#!/usr/bin/env python3
# Claude Code hook (Stop, Notification, PreToolUse): notifies the mywebterm tab
# when Claude is done or waiting for an answer. Does nothing outside mywebterm
# (MYWEBTERM variable set by the server), so it can be declared in
# ~/.claude/settings.json for all terminals.
#
# Claude Code reads hooks' standard output: write to the session's terminal,
# and nothing to stdout.
import json
import os
import re
import subprocess
import sys

if not os.environ.get("MYWEBTERM"):
    sys.exit(0)

try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)


def first_line(text, limit=180):
    text = " ".join(str(text or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


event = data.get("hook_event_name")
title = body = None

if event == "Stop":
    title = "Claude is done"
    body = first_line(data.get("last_assistant_message"))
elif event == "Notification":
    kind = data.get("notification_type")
    message = data.get("message", "")
    # "waiting for your input" arrives a minute after Stop: already notified
    if kind == "idle_prompt" or "waiting for your input" in message:
        sys.exit(0)
    title = "Claude needs permission" if kind == "permission_prompt" else "Claude is waiting for an answer"
    body = first_line(message)
elif event == "PreToolUse":
    tool = data.get("tool_name")
    tool_input = data.get("tool_input") or {}
    if tool == "AskUserQuestion":
        questions = tool_input.get("questions") or [{}]
        title = "Claude has a question"
        body = first_line(questions[0].get("question"))
    elif tool == "ExitPlanMode":
        title = "Claude proposes a plan"
        body = ""

if title is None:
    sys.exit(0)


def clean(text):
    return re.sub(r"[\x00-\x1f\x7f]", " ", text)


seq = f"\x1b]777;notify;{clean(title).replace(';', ',')};{clean(body or '')}\x07"
# In tmux, the sequence must pass through the multiplexer (set -g allow-passthrough on)
if os.environ.get("TMUX"):
    seq = "\x1bPtmux;" + seq.replace("\x1b", "\x1b\x1b") + "\x1b\\"


# Claude Code runs hooks in a new session, without a controlling terminal:
# /dev/tty can't be opened. Write to the terminal of the closest ancestor that
# has one (Claude Code itself).
def terminal():
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            return None
        try:
            out = subprocess.run(
                ["ps", "-o", "ppid=,tty=", "-p", str(pid)], capture_output=True, text=True, timeout=2
            ).stdout.split()
        except (OSError, subprocess.SubprocessError):
            return None
        if len(out) < 2:
            return None
        ppid, tty = out
        if tty not in ("?", "??"):
            return "/dev/" + tty if tty.startswith("tty") else "/dev/tty" + tty
        pid = int(ppid)
    return None


for path in ("/dev/tty", terminal()):
    if not path:
        continue
    try:
        with open(path, "w") as tty:
            tty.write(seq)
        break
    except OSError:
        pass
